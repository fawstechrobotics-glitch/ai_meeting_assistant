# ==============================================================================
# Assistive Real-Time Meeting Tool - Environment Configuration
# ==============================================================================

# Application Execution Settings
APP_NAME="Assistive Meeting Tool"
LOG_LEVEL="INFO"                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
HEADLESS_MODE=false                   # Set true for headless servers/testing
MOCK_HARDWARE=false                   # Set true if camera/mic are unavailable (uses synthetic feeds)

# Video & Camera Device Settings
CAMERA_INDEX=0                        # V4L2 device index (e.g. 0 for /dev/video0)
CAMERA_WIDTH=1280                     # Frame capture width
CAMERA_HEIGHT=720                     # Frame capture height
CAMERA_FPS=30                         # Target capture FPS
SIGN_LANGUAGE_MODE="ISL"              # Default sign language: "ISL" or "ASL"

# Audio & Microphone Device Settings
AUDIO_DEVICE_INDEX=                   # Input device index (leave blank for system default)
AUDIO_SAMPLE_RATE=16000               # Audio sample rate in Hz
AUDIO_CHUNK_SIZE=1024                 # Audio buffer chunk size
ENERGY_THRESHOLD=300                  # Microphone sensitivity threshold
DYNAMIC_ENERGY_THRESHOLD=true         # Dynamically adjust energy threshold for ambient noise

# Speech-to-Text (STT) Settings
STT_BACKEND="whisper"                 # "whisper", "faster-whisper", or "speech_recognition"
WHISPER_MODEL_SIZE="tiny"             # tiny, base, small, medium, large-v3
STT_LANGUAGE="en"                     # Spoken language code (e.g. en, hi)
SUBTITLE_DURATION_SECONDS=4.0         # How long subtitles linger on HUD

# Text-to-Speech (TTS) Settings
TTS_ENGINE="pyttsx3"                  # "pyttsx3" or "gtts"
TTS_SPEECH_RATE=160                   # Words per minute
TTS_VOLUME=1.0                        # Volume level: 0.0 to 1.0
TTS_DEBOUNCE_SECONDS=2.5              # Minimum seconds before repeating same gesture speech

# MediaPipe & Gesture Recognition Thresholds
MIN_DETECTION_CONFIDENCE=0.7          # Landmark detection confidence
MIN_TRACKING_CONFIDENCE=0.6           # Landmark tracking confidence
GESTURE_CONFIRMATION_FRAMES=6         # Number of consecutive frames needed to confirm gesture
CUSTOM_ISL_MODEL_PATH=""              # Optional path to pre-trained .onnx / .pt model
CUSTOM_ASL_MODEL_PATH=""              # Optional path to pre-trained .onnx / .pt model

# Display & Overlay Settings
WINDOW_TITLE="Assistive Meeting Assistant - Live Subtitles & Sign Translation"
DISPLAY_LANDMARKS=true                # Whether to render MediaPipe hand/pose skeleton
OVERLAY_OPACITY=0.75                  # Transparency of UI bars (0.0 to 1.0)
FONT_SCALE=0.7                        # Primary text font scale
